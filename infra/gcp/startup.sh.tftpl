#!/bin/bash
set -euo pipefail
umask 077
trap 'echo REQLOX_BOOTSTRAP_FAILED >&2; systemctl stop reqlox.service nginx.service 2>/dev/null || true' ERR
export DEBIAN_FRONTEND=noninteractive
timeout 600 apt-get update -qq
timeout 600 apt-get install -y --no-install-recommends python3 python3-pip python3-venv bubblewrap nginx ca-certificates
install -d -m 0755 /opt/reqlox /usr/local/libexec
printf '%s' '${bootstrap_b64}' | base64 -d > /usr/local/libexec/reqlox-bootstrap
printf '%s' '${context_b64}' | base64 -d > /usr/local/libexec/reqlox-host-context
chmod 0755 /usr/local/libexec/reqlox-bootstrap /usr/local/libexec/reqlox-host-context
timeout 900 /usr/bin/python3 /usr/local/libexec/reqlox-bootstrap
echo REQLOX_BOOTSTRAP_COMPLETE
