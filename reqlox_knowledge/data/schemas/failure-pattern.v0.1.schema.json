{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reqlox/failure-pattern.v0.1.schema.json",
  "title": "REQLOX FailurePattern v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "contract_type",
    "contract_version",
    "revision_id",
    "pattern_version",
    "canonical_name",
    "trigger",
    "context",
    "causal_graph",
    "applicability",
    "injection",
    "evidence_summary",
    "frequency_signal",
    "lifecycle",
    "provenance_refs",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^fp_[a-f0-9]{20}$"
    },
    "contract_type": {
      "const": "FailurePattern"
    },
    "contract_version": {
      "const": "0.1.0"
    },
    "revision_id": {
      "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/revisionId"
    },
    "pattern_version": {
      "type": "integer",
      "minimum": 1
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primitive"
      ],
      "properties": {
        "primitive": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9_]{1,79}|OTHER|UNKNOWN)$"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "optional"
      ],
      "properties": {
        "required": {
          "$ref": "#/$defs/contextMap"
        },
        "optional": {
          "$ref": "#/$defs/contextMap"
        }
      }
    },
    "causal_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges",
        "fingerprint"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:[a-z][a-z0-9_]{1,79}|OTHER|UNKNOWN)$"
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "relation"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "relation": {
                "enum": [
                  "causes",
                  "contributes_to",
                  "amplifies",
                  "triggers",
                  "prevents_recovery",
                  "masks",
                  "correlated_with",
                  "unknown"
                ]
              }
            }
          }
        },
        "fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "sha256"
          ],
          "properties": {
            "algorithm": {
              "const": "reqlox-graph-fingerprint-v1"
            },
            "sha256": {
              "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/sha256"
            }
          }
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_context"
      ],
      "properties": {
        "deployment_context": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "private_datacenter",
              "public_cloud",
              "hybrid",
              "bare_metal",
              "virtual_machine",
              "kubernetes",
              "generic",
              "other"
            ]
          }
        }
      }
    },
    "injection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "injectable",
        "mechanisms",
        "authority"
      ],
      "properties": {
        "injectable": {
          "type": "boolean"
        },
        "mechanisms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,79}$"
          }
        },
        "authority": {
          "const": "CANDIDATE_ONLY_NOT_EXECUTION_AUTHORIZATION"
        }
      }
    },
    "evidence_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_count",
        "organization_count",
        "source_document_count",
        "pattern_statistics_id"
      ],
      "properties": {
        "incident_count": {
          "type": "integer",
          "minimum": 1
        },
        "organization_count": {
          "type": "integer",
          "minimum": 1
        },
        "source_document_count": {
          "type": "integer",
          "minimum": 1
        },
        "pattern_statistics_id": {
          "type": "string",
          "pattern": "^pstats_[a-f0-9]{20}$"
        }
      }
    },
    "frequency_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_incidents",
        "organizations",
        "interpretation"
      ],
      "properties": {
        "observed_incidents": {
          "type": "integer",
          "minimum": 1
        },
        "organizations": {
          "type": "integer",
          "minimum": 1
        },
        "interpretation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frequent_in_corpus",
            "real_world_probability"
          ],
          "properties": {
            "frequent_in_corpus": {
              "type": "boolean"
            },
            "real_world_probability": {
              "type": "null"
            }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "candidate",
            "canonical",
            "superseded",
            "rejected"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "provenance_refs": {
      "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/provenanceRefs"
    },
    "limitations": {
      "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/limitations"
    }
  },
  "$defs": {
    "contextValue": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      ]
    },
    "contextMap": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{1,79}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/contextValue"
      }
    }
  }
}
