{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reqlox/provenance-record.v0.1.schema.json",
  "title": "REQLOX ProvenanceRecord v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "contract_type",
    "contract_version",
    "activity_type",
    "agent",
    "started_at",
    "ended_at",
    "input_refs",
    "output_refs",
    "parameters_sha256",
    "processing_boundary"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^prov_[a-f0-9]{20}$"
    },
    "contract_type": {
      "const": "ProvenanceRecord"
    },
    "contract_version": {
      "const": "0.1.0"
    },
    "activity_type": {
      "enum": [
        "FETCH",
        "NORMALIZE",
        "EXTRACT",
        "JUDGE",
        "CANONICALIZE_INCIDENT",
        "CANONICALIZE_PATTERN",
        "COMPUTE_STATISTICS",
        "BUILD_EMBEDDING_TEXT",
        "EMBED",
        "COMPOSE_SCENARIO",
        "IMPORT_LEGACY"
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "version",
        "model_provider",
        "model_name",
        "model_version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "CODE",
            "MODEL",
            "HUMAN",
            "IMPORT"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "model_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "output_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "parameters_sha256": {
      "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/sha256"
    },
    "processing_boundary": {
      "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/processingBoundary"
    }
  }
}
