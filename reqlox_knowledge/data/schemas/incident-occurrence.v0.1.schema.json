{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reqlox/incident-occurrence.v0.1.schema.json",
  "title": "REQLOX IncidentOccurrence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "contract_type",
    "contract_version",
    "revision_id",
    "created_at",
    "lifecycle_status",
    "canonical_name",
    "organization",
    "time",
    "environment",
    "impact",
    "source_document_ids",
    "evidence_ids",
    "dedup",
    "identity_verification",
    "confidence",
    "provenance_refs",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^inc_[a-f0-9]{20}$"
    },
    "contract_type": {
      "const": "IncidentOccurrence"
    },
    "contract_version": {
      "const": "0.1.0"
    },
    "revision_id": {
      "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/revisionId"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "lifecycle_status": {
      "enum": [
        "CANDIDATE",
        "CANONICAL",
        "SUPERSEDED",
        "REJECTED"
      ]
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1
    },
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "ended_at",
        "precision"
      ],
      "properties": {
        "started_at": {
          "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/nullableDateTime"
        },
        "ended_at": {
          "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/nullableDateTime"
        },
        "precision": {
          "enum": [
            "second",
            "minute",
            "hour",
            "day",
            "order_only",
            "unknown"
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_context",
        "infrastructure",
        "technologies"
      ],
      "properties": {
        "deployment_context": {
          "enum": [
            "private_datacenter",
            "public_cloud",
            "hybrid",
            "edge",
            "unknown",
            "other"
          ]
        },
        "infrastructure": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,79}$"
          }
        },
        "technologies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affected_components",
        "symptoms"
      ],
      "properties": {
        "affected_components": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "symptoms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_document_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^srcdoc_[a-f0-9]{20}$"
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ev_[a-f0-9]{20}$"
      }
    },
    "dedup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_cluster_id"
      ],
      "properties": {
        "incident_cluster_id": {
          "type": "string",
          "pattern": "^icluster_[a-f0-9]{20}$"
        }
      }
    },
    "identity_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "method",
        "jev_judgment_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "CANDIDATE",
            "ACCEPTED",
            "REJECTED",
            "REVIEW"
          ]
        },
        "method": {
          "enum": [
            "DETERMINISTIC_EXACT",
            "JEV",
            "HUMAN",
            "UNVERIFIED"
          ]
        },
        "jev_judgment_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^jev_[a-f0-9]{20}$"
          }
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_identity"
      ],
      "properties": {
        "incident_identity": {
          "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/probability"
        }
      }
    },
    "provenance_refs": {
      "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/provenanceRefs"
    },
    "limitations": {
      "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/limitations"
    }
  }
}
