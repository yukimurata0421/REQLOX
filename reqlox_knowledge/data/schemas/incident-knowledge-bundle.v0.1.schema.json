{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reqlox/incident-knowledge-bundle.v0.1.schema.json",
  "title": "REQLOX IncidentKnowledgeBundle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "contract_type",
    "contract_version",
    "created_at",
    "status",
    "taxonomy",
    "artifacts",
    "blobs",
    "processing_boundary",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ikb_[a-f0-9]{20}$"
    },
    "contract_type": {
      "const": "IncidentKnowledgeBundle"
    },
    "contract_version": {
      "const": "0.1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "VALIDATED",
        "REJECTED"
      ]
    },
    "taxonomy": {
      "$ref": "#/$defs/fileRef"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/fileRef"
          },
          {
            "type": "object",
            "required": [
              "contract_type",
              "artifact_id"
            ],
            "properties": {
              "contract_type": {
                "enum": [
                  "ProvenanceRecord",
                  "SourceDocument",
                  "EvidenceSpan",
                  "IncidentOccurrence",
                  "FailureEvent",
                  "CausalEdge",
                  "FailurePattern",
                  "PatternOccurrence",
                  "PatternStatistics",
                  "JevJudgment",
                  "KnowledgeEmbedding",
                  "FaultInjectionCandidate"
                ]
              },
              "artifact_id": {
                "type": "string",
                "minLength": 3
              }
            }
          }
        ]
      }
    },
    "blobs": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/fileRef"
          },
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "RAW_SOURCE",
                  "NORMALIZED_TEXT",
                  "EMBEDDING_VECTOR"
                ]
              }
            }
          }
        ]
      }
    },
    "processing_boundary": {
      "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/processingBoundary"
    },
    "limitations": {
      "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/limitations"
    }
  },
  "$defs": {
    "fileRef": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.).+$"
        },
        "sha256": {
          "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
