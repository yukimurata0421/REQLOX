{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reqlox/evidence-span.v0.1.schema.json",
  "title": "REQLOX EvidenceSpan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "contract_type",
    "contract_version",
    "revision_id",
    "created_at",
    "source_document_id",
    "locator",
    "content_hash",
    "evidence_types",
    "extracted_claim",
    "extraction",
    "verification",
    "provenance_refs",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ev_[a-f0-9]{20}$"
    },
    "contract_type": {
      "const": "EvidenceSpan"
    },
    "contract_version": {
      "const": "0.1.0"
    },
    "revision_id": {
      "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/revisionId"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_document_id": {
      "type": "string",
      "pattern": "^srcdoc_[a-f0-9]{20}$"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_char",
        "end_char",
        "section"
      ],
      "properties": {
        "start_char": {
          "type": "integer",
          "minimum": 0
        },
        "end_char": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "content_hash": {
      "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/sha256"
    },
    "evidence_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "root_cause",
          "impact",
          "timeline",
          "mitigation",
          "symptom",
          "recovery",
          "contributing_factor",
          "context",
          "unknown"
        ]
      }
    },
    "extracted_claim": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject",
            "predicate",
            "object",
            "origin"
          ],
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "predicate": {
              "type": "string",
              "minLength": 1
            },
            "object": {
              "type": "string",
              "minLength": 1
            },
            "origin": {
              "enum": [
                "SOURCE_REPORTED",
                "EXTRACTOR_INTERPRETATION"
              ]
            }
          }
        }
      ]
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extractor",
        "model_provider",
        "model",
        "version",
        "input_sha256",
        "extracted_at",
        "confidence"
      ],
      "properties": {
        "extractor": {
          "enum": [
            "deterministic",
            "llm",
            "human"
          ]
        },
        "model_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/sha256"
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/probability"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "jev_judgment_id",
        "verified_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "CANDIDATE",
            "ACCEPTED",
            "REJECTED",
            "REVIEW"
          ]
        },
        "jev_judgment_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^jev_[a-f0-9]{20}$"
        },
        "verified_at": {
          "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/nullableDateTime"
        }
      }
    },
    "provenance_refs": {
      "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/provenanceRefs"
    },
    "limitations": {
      "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/limitations"
    }
  }
}
