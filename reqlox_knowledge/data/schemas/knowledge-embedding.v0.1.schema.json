{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reqlox/knowledge-embedding.v0.1.schema.json",
  "title": "REQLOX KnowledgeEmbedding v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "contract_type",
    "contract_version",
    "revision_id",
    "entity_type",
    "entity_id",
    "source_entity_ids",
    "causal_path",
    "embedding_model",
    "embedding_model_version",
    "dimensions",
    "schema_version",
    "input_text",
    "input_sha256",
    "vector",
    "authority",
    "rebuildable",
    "created_at",
    "provenance_refs",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^embk_[a-f0-9]{20}$"
    },
    "contract_type": {
      "const": "KnowledgeEmbedding"
    },
    "contract_version": {
      "const": "0.1.0"
    },
    "revision_id": {
      "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/revisionId"
    },
    "entity_type": {
      "enum": [
        "incident",
        "evidence",
        "failure_pattern",
        "causal_path"
      ]
    },
    "entity_id": {
      "type": "string",
      "minLength": 3
    },
    "source_entity_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "causal_path": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodes",
            "edges"
          ],
          "properties": {
            "nodes": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "pattern": "^(?:[a-z][a-z0-9_]{1,79}|OTHER|UNKNOWN)$"
              }
            },
            "edges": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "to",
                  "relation"
                ],
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "relation": {
                    "enum": [
                      "causes",
                      "contributes_to",
                      "amplifies",
                      "triggers",
                      "prevents_recovery",
                      "masks",
                      "correlated_with",
                      "unknown"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "embedding_model": {
      "type": "string",
      "minLength": 1
    },
    "embedding_model_version": {
      "type": "string",
      "minLength": 1
    },
    "dimensions": {
      "type": "integer",
      "minimum": 1
    },
    "schema_version": {
      "const": "reqlox-embedding-text-v1"
    },
    "input_text": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/sha256"
    },
    "vector": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "authority": {
      "const": "INDEX_ONLY_NOT_SOURCE_OF_TRUTH"
    },
    "rebuildable": {
      "const": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance_refs": {
      "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/provenanceRefs"
    },
    "limitations": {
      "$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/limitations"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "entity_type": {
            "const": "causal_path"
          }
        }
      },
      "then": {
        "properties": {
          "entity_id": {
            "pattern": "^cpath_[a-f0-9]{20}$"
          },
          "causal_path": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "causal_path": {
            "type": "null"
          }
        }
      }
    }
  ]
}
