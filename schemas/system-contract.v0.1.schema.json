{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reqlox/system-contract.v0.1.schema.json",
  "title": "REQLOX SystemContract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "contract_type",
    "contract_version",
    "revision_id",
    "created_at",
    "system_ir_ref",
    "status",
    "owner",
    "hard_invariants",
    "recovery_objectives",
    "observation_requirements",
    "execution_boundary",
    "stop_conditions",
    "cleanup_requirements",
    "freeze",
    "limitations"
  ],
  "$defs": {
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidenceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^tev_[a-f0-9]{20}$"}}
  },
  "properties": {
    "$schema": {"type": "string"},
    "id": {"type": "string", "pattern": "^scontract_[a-f0-9]{20}$"},
    "contract_type": {"const": "SystemContract"},
    "contract_version": {"const": "0.1.0"},
    "revision_id": {"$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/revisionId"},
    "created_at": {"type": "string", "format": "date-time"},
    "system_ir_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision_id"],
      "properties": {
        "id": {"type": "string", "pattern": "^sir_[a-f0-9]{20}$"},
        "revision_id": {"$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/revisionId"}
      }
    },
    "status": {"const": "DRAFT_REVIEW_REQUIRED"},
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "identity", "approved"],
      "properties": {
        "role": {"const": "HUMAN_TARGET_OWNER"},
        "identity": {"type": "null"},
        "approved": {"const": false}
      }
    },
    "hard_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "origin", "verification_state", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^invariant_[a-z][a-z0-9_]{1,79}$"},
          "statement": {"type": "string", "minLength": 1},
          "origin": {"const": "PROJECT_NORMALIZATION"},
          "verification_state": {"const": "SOURCE_DEFINED_REVIEW_REQUIRED"},
          "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
        }
      }
    },
    "recovery_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "deadline_seconds", "state"],
        "properties": {
          "id": {"type": "string", "pattern": "^objective_[a-z][a-z0-9_]{1,79}$"},
          "scope": {"type": "string", "minLength": 1},
          "deadline_seconds": {"type": "null"},
          "state": {"const": "UNSPECIFIED_REQUIRES_OWNER"}
        }
      }
    },
    "observation_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_components_explicit", "all_restart_domains_explicit", "required_conclusion_axes", "missing_evidence_policy", "evidence_ids"],
      "properties": {
        "all_components_explicit": {"const": true},
        "all_restart_domains_explicit": {"const": true},
        "required_conclusion_axes": {"$ref": "#/$defs/stringArray"},
        "missing_evidence_policy": {"const": "INCONCLUSIVE_OR_CERTIFICATION_PAUSED_NEVER_PASS"},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "execution_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permitted_environments", "production_allowed", "live_stream_allowed", "fault_injection_allowed", "authorization_ref"],
      "properties": {
        "permitted_environments": {"type": "array", "uniqueItems": true, "items": {"const": "DISPOSABLE_SANDBOX"}},
        "production_allowed": {"const": false},
        "live_stream_allowed": {"const": false},
        "fault_injection_allowed": {"const": false},
        "authorization_ref": {"type": "null"}
      }
    },
    "stop_conditions": {"$ref": "#/$defs/stringArray"},
    "cleanup_requirements": {"$ref": "#/$defs/stringArray"},
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "frozen_at", "approved_by"],
      "properties": {
        "state": {"const": "NOT_FROZEN"},
        "frozen_at": {"type": "null"},
        "approved_by": {"type": "null"}
      }
    },
    "limitations": {"$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/limitations"}
  }
}
