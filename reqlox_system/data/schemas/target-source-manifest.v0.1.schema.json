{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reqlox/target-source-manifest.v0.1.schema.json",
  "title": "REQLOX TargetSourceManifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "contract_type",
    "contract_version",
    "revision_id",
    "created_at",
    "target_id",
    "source_repository",
    "source_files",
    "native_validation",
    "processing_boundary",
    "limitations"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "id": {"type": "string", "pattern": "^tsm_[a-f0-9]{20}$"},
    "contract_type": {"const": "TargetSourceManifest"},
    "contract_version": {"const": "0.1.0"},
    "revision_id": {"$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/revisionId"},
    "created_at": {"type": "string", "format": "date-time"},
    "target_id": {"type": "string", "pattern": "^target_[a-z][a-z0-9_]{1,79}$"},
    "source_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "git_commit_sha1", "git_tree_sha1", "branch_observed", "worktree_clean_at_capture"],
      "properties": {
        "logical_name": {"type": "string", "minLength": 1},
        "git_commit_sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "git_tree_sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "branch_observed": {"type": "string", "minLength": 1},
        "worktree_clean_at_capture": {"type": "boolean"}
      }
    },
    "revision_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_package_manifest_id",
        "baseline_commit_sha1",
        "relationship",
        "changed_paths",
        "changed_paths_sha256",
        "captured_changed_paths",
        "omitted_changed_paths"
      ],
      "properties": {
        "baseline_package_manifest_id": {"type": "string", "pattern": "^tpm_[a-f0-9]{20}$"},
        "baseline_commit_sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "relationship": {"const": "DESCENDANT"},
        "changed_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9._/@-]+$"}
        },
        "changed_paths_sha256": {"$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/sha256"},
        "captured_changed_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9._/@-]+$"}
        },
        "omitted_changed_paths": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "snapshot_path", "sha256", "role"],
        "properties": {
          "path": {"type": "string", "pattern": "^[A-Za-z0-9._/@-]+$"},
          "snapshot_path": {"type": "string", "pattern": "^source/stream_recovery_control/[A-Za-z0-9._/@-]+$"},
          "sha256": {"$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/sha256"},
          "role": {"enum": [
            "CANONICAL_GRAPH",
            "SOURCE_SCHEMA",
            "CURRENT_SPEC",
            "POLICY",
            "TRUST_MODEL",
            "HARNESS_SCENARIO",
            "HARNESS_CONTRACT",
            "SUT_OBSERVER_IMPLEMENTATION",
            "ORACLE_IMPLEMENTATION",
            "CLASSIFIER_IMPLEMENTATION",
            "HARNESS_CONTROL_IMPLEMENTATION",
            "FAULT_INJECTOR_IMPLEMENTATION",
            "TRACEABILITY_IMPLEMENTATION",
            "CONTROL_IMPLEMENTATION",
            "VERIFICATION_TEST",
            "SOURCE_IMPLEMENTATION",
            "DATABASE_MIGRATION",
            "DEPLOYMENT_CONFIGURATION",
            "BUILD_OR_VALIDATION_TOOL",
            "SUPPORTING_DOCUMENTATION",
            "REPOSITORY_METADATA",
            "SUPPORTING_SCHEMA"
          ]}
        }
      }
    },
    "source_tree_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracked_file_count", "captured_file_count", "omitted_paths", "tracked_paths_sha256"],
      "properties": {
        "tracked_file_count": {"type": "integer", "minimum": 1},
        "captured_file_count": {"type": "integer", "minimum": 1},
        "omitted_paths": {"type": "array", "maxItems": 0},
        "tracked_paths_sha256": {"$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/sha256"}
      }
    },
    "native_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "validator", "mapping_sha256", "counts"],
      "properties": {
        "status": {"const": "PASS"},
        "validator": {"type": "string", "minLength": 1},
        "mapping_sha256": {"$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/sha256"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hosts", "layers", "nodes", "edges", "restart_domains", "failure_modes"],
          "properties": {
            "hosts": {"type": "integer", "minimum": 0},
            "layers": {"type": "integer", "minimum": 0},
            "nodes": {"type": "integer", "minimum": 0},
            "edges": {"type": "integer", "minimum": 0},
            "restart_domains": {"type": "integer", "minimum": 0},
            "failure_modes": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "processing_boundary": {"$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/processingBoundary"},
    "limitations": {"$ref": "https://example.invalid/reqlox/incident-knowledge-common.v0.1.schema.json#/$defs/limitations"}
  }
}
